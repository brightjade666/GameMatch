{
  "info": {
    "_postman_id": "c6c0db7a-4b1c-4f82-8c2a-2d02e3f6b5a1",
    "name": "gamematch-backend",
    "description": "GameMatch 后端接口集合。执行登录请求后会自动保存 access_token 和 refresh_token。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Base",
      "item": [
        {
          "name": "hello",
          "request": { "method": "GET", "url": "{{base_url}}/hello" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const json = pm.response.json();",
                "if (json.code === 200) {",
                "  pm.environment.set('access_token', json.access_token || json.token);",
                "  pm.environment.set('refresh_token', json.refresh_token);",
                "  pm.environment.set('user_id', json.user_id);",
                "}"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"test\",\"password\":\"123456\"}" },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"test2\",\"password\":\"123456\"}" },
            "url": "{{base_url}}/register"
          }
        },
        {
          "name": "refresh token",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const json = pm.response.json();",
                "if (json.code === 200) {",
                "  pm.environment.set('access_token', json.access_token);",
                "  pm.environment.set('refresh_token', json.refresh_token);",
                "}"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Refresh-Token", "value": "{{refresh_token}}" }],
            "url": "{{base_url}}/refresh-token"
          }
        },
        {
          "name": "logout",
          "request": { "method": "POST", "url": "{{base_url}}/logout" }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        { "name": "info", "request": { "method": "GET", "url": "{{base_url}}/user/info?userId={{user_id}}" } },
        {
          "name": "update",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"user_id\":{{user_id}},\"username\":\"test\",\"gender\":1,\"age\":20,\"contact\":\"test\",\"game_name\":\"Game\",\"game_rank\":\"Diamond\",\"personality\":\"Active\",\"playtime\":\"18:00~22:00\",\"matchneed\":\"Team up\",\"introduction\":\"\"}" },
            "url": "{{base_url}}/user/update"
          }
        },
        { "name": "match", "request": { "method": "GET", "url": "{{base_url}}/user/match?gameId={{game_id}}" } },
        { "name": "publicInfo", "request": { "method": "GET", "url": "{{base_url}}/user/publicInfo?userId={{user_id}}" } },
        { "name": "matchAdvanced", "request": { "method": "GET", "url": "{{base_url}}/user/matchAdvanced?gameId={{game_id}}&gameName=Game&playtimeStart=18:00&playtimeEnd=22:00&matchNeed=Team%20up&personality=Active&excludeUserId={{user_id}}" } }
      ]
    },
    {
      "name": "Team",
      "item": [
        { "name": "list", "request": { "method": "GET", "url": "{{base_url}}/team/list?userId={{user_id}}" } },
        { "name": "detail", "request": { "method": "GET", "url": "{{base_url}}/team/detail/{{team_id}}" } },
        { "name": "hot top", "request": { "method": "GET", "url": "{{base_url}}/team/hot/top?limit=10" } },
        { "name": "hot rank", "request": { "method": "GET", "url": "{{base_url}}/team/hot/rank/{{team_id}}" } },
        { "name": "team match", "request": { "method": "GET", "url": "{{base_url}}/team/match?limit=10" } },
        {
          "name": "publish",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"gameId\":{{game_id}},\"teamName\":\"Test Team\",\"teamCover\":\"\",\"teamNeed\":\"Team up\",\"teamDesc\":\"Test\",\"leaderId\":{{user_id}},\"needNum\":5}" },
            "url": "{{base_url}}/team/publish"
          }
        },
        { "name": "comment", "request": { "method": "POST", "url": "{{base_url}}/team/comment?teamId={{team_id}}&userId={{user_id}}&content=good" } },
        {
          "name": "apply",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"teamId\":{{team_id}},\"userId\":{{user_id}},\"status\":0}" },
            "url": "{{base_url}}/team/apply"
          }
        },
        { "name": "my applies", "request": { "method": "GET", "url": "{{base_url}}/team/my/applies?leaderId={{user_id}}" } },
        { "name": "dissolve", "request": { "method": "POST", "url": "{{base_url}}/team/dissolve?teamId={{team_id}}&leaderId={{user_id}}" } },
        { "name": "leave", "request": { "method": "POST", "url": "{{base_url}}/team/leave?teamId={{team_id}}&userId={{user_id}}" } },
        { "name": "agree", "request": { "method": "POST", "url": "{{base_url}}/team/agree?id={{apply_id}}" } },
        { "name": "reject", "request": { "method": "POST", "url": "{{base_url}}/team/reject?id={{apply_id}}" } },
        { "name": "my joined", "request": { "method": "GET", "url": "{{base_url}}/team/my/joined?userId={{user_id}}" } },
        { "name": "created", "request": { "method": "GET", "url": "{{base_url}}/team/created?leaderId={{user_id}}" } },
        { "name": "remove member", "request": { "method": "POST", "url": "{{base_url}}/team/remove?teamId={{team_id}}&leaderId={{user_id}}&userId={{target_user_id}}" } }
      ]
    },
    {
      "name": "Friend",
      "item": [
        { "name": "apply", "request": { "method": "POST", "url": "{{base_url}}/friend/apply?fromUserId={{user_id}}&toUserId={{target_user_id}}&reason=play%20together" } },
        { "name": "received", "request": { "method": "GET", "url": "{{base_url}}/friend/applies/received?userId={{user_id}}" } },
        { "name": "handle", "request": { "method": "POST", "url": "{{base_url}}/friend/handle?applyId={{apply_id}}&action=accept" } },
        { "name": "list", "request": { "method": "GET", "url": "{{base_url}}/friend/list?userId={{user_id}}" } },
        { "name": "delete", "request": { "method": "DELETE", "url": "{{base_url}}/friend/delete?userId={{user_id}}&friendId={{target_user_id}}" } }
      ]
    },
    {
      "name": "Chat",
      "item": [
        { "name": "team list", "request": { "method": "GET", "url": "{{base_url}}/chat/team/list?userId={{user_id}}" } },
        { "name": "team members", "request": { "method": "GET", "url": "{{base_url}}/chat/team/members?teamId={{team_id}}" } },
        { "name": "team send", "request": { "method": "POST", "url": "{{base_url}}/chat/team/send?teamId={{team_id}}&fromId={{user_id}}&content=hello&msgType=text" } },
        { "name": "team history", "request": { "method": "GET", "url": "{{base_url}}/chat/team/history?teamId={{team_id}}" } },
        { "name": "private my", "request": { "method": "GET", "url": "{{base_url}}/chat/private/my?userId={{user_id}}" } },
        { "name": "private members", "request": { "method": "GET", "url": "{{base_url}}/chat/private/members?userId={{user_id}}" } },
        { "name": "private send", "request": { "method": "POST", "url": "{{base_url}}/chat/private/send?fromId={{user_id}}&toUserId={{target_user_id}}&content=hello&msgType=text" } },
        { "name": "private history", "request": { "method": "GET", "url": "{{base_url}}/chat/private/history?userId1={{user_id}}&userId2={{target_user_id}}" } },
        { "name": "private unread count", "request": { "method": "GET", "url": "{{base_url}}/chat/private/unread-count?userId={{user_id}}" } }
      ]
    },
    {
      "name": "Notification",
      "item": [
        { "name": "my", "request": { "method": "GET", "url": "{{base_url}}/notification/my?userId={{user_id}}" } },
        { "name": "unread count", "request": { "method": "GET", "url": "{{base_url}}/notification/unread-count?userId={{user_id}}" } }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"userId\":{{user_id}},\"msg\":\"hello\"}" },
            "url": "{{base_url}}/ai/chat"
          }
        },
        { "name": "history", "request": { "method": "GET", "url": "{{base_url}}/ai/history?userId={{user_id}}" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "users", "request": { "method": "GET", "url": "{{base_url}}/admin/users?adminId={{admin_id}}" } },
        { "name": "user detail", "request": { "method": "GET", "url": "{{base_url}}/admin/user/{{target_user_id}}?adminId={{admin_id}}" } },
        { "name": "change status", "request": { "method": "PUT", "url": "{{base_url}}/admin/user/{{target_user_id}}/status?adminId={{admin_id}}&status=1" } },
        { "name": "delete user", "request": { "method": "DELETE", "url": "{{base_url}}/admin/user/{{target_user_id}}?adminId={{admin_id}}" } },
        { "name": "teams", "request": { "method": "GET", "url": "{{base_url}}/admin/teams?adminId={{admin_id}}" } },
        { "name": "team detail", "request": { "method": "GET", "url": "{{base_url}}/admin/team/{{team_id}}?adminId={{admin_id}}" } },
        { "name": "delete team", "request": { "method": "DELETE", "url": "{{base_url}}/admin/team/{{team_id}}?adminId={{admin_id}}" } },
        { "name": "search users", "request": { "method": "GET", "url": "{{base_url}}/admin/users/search?adminId={{admin_id}}&keyword=test" } },
        { "name": "search teams", "request": { "method": "GET", "url": "{{base_url}}/admin/teams/search?adminId={{admin_id}}&keyword=test" } },
        { "name": "statistics", "request": { "method": "GET", "url": "{{base_url}}/admin/statistics?adminId={{admin_id}}" } }
      ]
    },
    {
      "name": "File",
      "item": [
        {
          "name": "upload",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "url": "{{base_url}}/file/upload"
          }
        }
      ]
    }
  ]
}
